%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 8
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: " Vol is vol, er zijn veel te weinig reddingsboten en er is nog maar
    \xE9\xE9n plekje over in de boot. Jij en een paar andere reizigers proberen het
    laatste plekje te bemachtigen"
  answers:
  - skillNeeded:
    - skillType: 3
      skillAmountNeeded: 3
    action: Overleg met de andere reizigers dat het plekje voor jou is.
    result: 'De andere reizigers zijn het eens met je dat jij de laatste plek verdient.


      Je
      karakter is veilig, deze kan geen acties meer uitvoeren of vaardigheid punten
      verdienen. '
    resultFailed: 'De andere reizigers zijn het niet eens met je. Er breekt een gevecht
      uit en uiteindelijk word je van de boot af gegooid door een andere reiziger.


      Je
      personage gaat dood.'
    change:
    - skillToBeChanged: 8
      changeAmount: 0
    changeFailed:
    - skillToBeChanged: 7
      changeAmount: 0
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: Je betaald de andere reizigers om jou de laatste plek te geven op de
      veiligheidsboot.
    result: 'De andere reizigers nemen het geld aan en geven jou de laatste plek
      op de reddingsboot.


      Je karakter is veilig, deze kan geen acties meer
      uitvoeren of vaardigheid punten verdienen. '
    resultFailed: 'Je hebt niet genoeg kapitaal om de andere reizigers om te kopen.
      Een van de reizigers vind het onacceptabel dat je hem probeerde om te kopen
      en steekt je met een mes.


      Je karakter gaat dood'
    change:
    - skillToBeChanged: 8
      changeAmount: 0
    changeFailed:
    - skillToBeChanged: 7
      changeAmount: 0
