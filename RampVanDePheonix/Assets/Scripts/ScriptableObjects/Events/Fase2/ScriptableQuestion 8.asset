  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 8
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: " Vol is vol, er zijn veel te weinig reddingsboten en er is nog maar
    \xE9\xE9n plekje over in de boot. "
  answers:
  - skillNeeded: []
    action: 'Neem plaats in de reddingsboot. '
    result: 'Je karakter is veilig, deze kan geen acties meer uitvoeren of vaardigheid
      punten verdienen. '
    change: []
  - skillNeeded: []
    action: 'Maak de keuze om niet in te stappen. '
    result: 'Je karakter gaat dood, maar de vaardigheden en kapitaal kan gegeven
      worden aan een ander karakter (ook vrijgestelde) '
    change: []
  - skillNeeded: []
    action: 'Gooi iemand extra uit de boot om 2 plekken te krijgen. '
    result: 'Je maakt de keuze om iemand al in de boot eruit te duwen, 1 karakter
      is veilig, 50% kans dat het andere karakter of doodgaat of veiliggesteld wordt. '
    change: []
