%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 5
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: Op de boot is ook een zwangere vrouw. Het lijkt erop alsof de vrouw ernstig
    ziek is geworden, ze heeft medicijnen nodig om te blijven leven.
  answers:
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: Koop medicijnen van de kapitein.
    result: 'Je koopt medicijnen van de kapitein en geeft ze aan de vrouw. Ze bedankt
      je voor de hulp en geeft je een hamer die eerst van haar overleden man was.


      Verdien
      2 sociaal, Verdien 1 bouwkunde'
    resultFailed: 'De kapitein geeft je niet de medicijnen, omdat je niet genoeg
      kapitaal hebt om het te betalen. Na een paar nachten overlijd de vrouw aan
      haar ziekte.


      Verlies 2 sociaal.'
    change:
    - skillToBeChanged: 1
      changeAmount: -3
    - skillToBeChanged: 3
      changeAmount: 2
    - skillToBeChanged: 2
      changeAmount: 1
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -2
  - skillNeeded:
    - skillType: 4
      skillAmountNeeded: 3
    action: Je probeert de vrouw zo goed mogelijk te helpen zonder medicijnen
    result: 'Dankzij jouw hulp overleefd de vrouw de ziekte. De vrouw bedankt jou
      door je wat extra kapitaal te geven.


      Verdien 2 sociaal, Verlies 1 etensvoorraad,
      Verdien 1 kapitaal.'
    resultFailed: 'Je doet je best om de vrouw zo goed mogelijk te helpen, maar helaas
      is je kennis niet goed genoeg om haar succesvol te helpen. Uiteindelijk overlijd
      de vrouw aan de ziekte.


      Verlies 1 sociaal


'
    change:
    - skillToBeChanged: 3
      changeAmount: 2
    - skillToBeChanged: 5
      changeAmount: -1
    - skillToBeChanged: 1
      changeAmount: 1
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -1
  - skillNeeded: []
    action: Je wacht het uit en hoopt dat het beter gaat met de vrouw.
    result: 'De vrouw overleid uiteindelijk aan de ziekte. De sfeer ligt voor de
      rest van de reis heel laag.


      Verlies 2 sociaal'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: -2
    changeFailed: []
