    - skillToBeChanged: 0
      changeAmount: -5
    - skillToBeChanged: 3
      changeAmount: 5
    - skillToBeChanged: 5
      changeAmount: -2
  - skillNeeded: []
    action: 'Niets doen '
    result: 'De vrouw overlijdt. Karakter gaat dood. '
