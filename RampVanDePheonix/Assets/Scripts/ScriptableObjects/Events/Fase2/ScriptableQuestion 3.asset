MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: "Tijdens de overtocht naar Amerika breekt er een ziekte uit aan boord.
    De ziekte treft vooral de kinderen. E\xE9n kind wordt ernstig ziek. "
  answers:
  - skillNeeded:
    - skillType: 4
      skillAmountNeeded: 10
    action: '(Leervermogen > 10?) Doe onderzoek naar een oplossing '
    result: 'Je helpt alle kinderen aan boord, sommige geven je geld voor je hulp.
      Je verdient 5 kapitaal, verliest 5 honger. '
    change:
    - skillToBeChanged: 1
      changeAmount: 5
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 5
    action: '(Kapitaal > 5) Betaal voor medicatie '
    result: 'Je koopt medicijnen voor het zieke kind. Je verliest 5 Kapitaal, verdient
      5 Aanpassingsvermogen. '
    change:
    - skillToBeChanged: 1
      changeAmount: -5
    - skillToBeChanged: 0
      changeAmount: 5
  - skillNeeded: []
    action: 'Isoleren en laten rusten, minimale verzorging. '
    result: 'Je laat het kind rusten en verzorgt hem minimaal. Je verliest 5 Sociaal,
      verliest 5 Honger (honger ziek). '
    change:
    - skillToBeChanged: 3
      changeAmount: -5
    - skillToBeChanged: 5
      changeAmount: -5
  - skillNeeded: []
    action: 'Niets doen en hopen op het beste. '
    result: 'Hopen werkt niet altijd. Karakter(kind) gaat dood '
    change: []
