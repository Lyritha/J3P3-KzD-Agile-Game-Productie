MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: "Tijdens de overtocht naar Amerika breekt er een ziekte uit aan boord.
    De ziekte treft vooral de kinderen. E\xE9n kind wordt ernstig ziek. "
  answers:
  - skillNeeded:
    - skillType: 4
      skillAmountNeeded: 3
    action: Probeer het kind te helpen.
    result: 'Je doet je best met je gelimiteerde kennis om de kinderen te helpen.
      Uiteindelijk is het je gelukt om de kinderen te redden. een  paar ouders van
      de kinderen geven je wat geld voor je hulp.


      Verdien 2 kapitaal, verdien
      2 sociaal.

'
    resultFailed: 'Je doet je best om de kinderen te helpen met je gelimiteerde kennis.
      Helaas is het je niet gelukt om de kinderen te redden. Veel van de kinderen
      overleven de ziekte niet.


      Verlies  2 sociaal.'
    change:
    - skillToBeChanged: 1
      changeAmount: 2
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -2
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: De kapitein heeft wat medicijen maar ze kosten aardig veel geld.
    result: 'Je koopt medicijnen voor de kinderen. er waren alleen niet genoeg medicijnen
      voor alle kinderen. een paar van de kinderen hebben de ziekte niet overleeft.
      De ouders van de overlevende kinderen bedanken je erg.


      Verlies 2 kapitaal,
      Verdien 2 sociaal.'
    resultFailed: 'Je doet je best om te onderhandelen met de kapitein, maar hij
      past de prijs voor de medicijnen niet aan. De kinderen die getroffen waren
      door de ziekte zijn overleden.


      Verlies 2 sociaal.'
    change:
    - skillToBeChanged: 1
      changeAmount: -3
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -2
  - skillNeeded: []
    action: 'Niets doen en hopen op het beste. '
    result: 'Je hoopte dat de ziekte voorbij zou gaan maar helaas bleven de kinderen
      ziek. De kinderen hebben het niet overleefd.


      een kind uit jouw party
      gaat dood. (nog niet werkend)'
    resultFailed: 
    change: []
    changeFailed: []
