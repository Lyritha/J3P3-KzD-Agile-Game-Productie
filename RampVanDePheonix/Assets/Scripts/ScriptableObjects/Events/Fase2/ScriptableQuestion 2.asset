  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: ' Je bent aan boord van de Phoenix, samen met landverhuizers uit de Achterhoek.
    Om iedereen beter te leren kennen, vraag je naar hun beweegredenen om te emigreren.
    Welke actie onderneem je om hun verhalen te achterhalen? '
  answers:
  - skillNeeded: []
    action: 'Vraag rond naar armoede en werkloosheid in hun dorp. '
    result: 'De mensen beginnen te praten over hoeveel armoede er rond ging in hun
      dorpen. Je realiseert je dat veel dorpen dezelfde problemen hebben.


      Verdien
      1 sociaal.'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: 1
    changeFailed: []
  - skillNeeded: []
    action: 'Deel je eigen dromen en verlangens naar een nieuw leven. '
    result: 'De mensen waarmee je praat delen ook hun eigen dromen. Je maakt op deze
      manier nieuwe vrienden.


      Verdien 2 sociaal'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed: []
  - skillNeeded: []
    action: 'Observeer stilletjes wie met wie praat en probeer conclusies te trekken. '
    result: 'De mensen op de boot realiseren dat je aan het meeluisteren bent en
      vinden dit best raar. Wanneer je langs hun heen loopt beginnen ze over je te
      roddelen.


      Verlies 2 sociaal'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: -2
    changeFailed: []
