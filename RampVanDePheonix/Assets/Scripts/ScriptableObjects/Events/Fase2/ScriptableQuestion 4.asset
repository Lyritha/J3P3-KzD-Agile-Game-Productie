  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 4
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: "Een hevige storm slaat toe tijdens de overtocht. E\xE9n kind van een
    andere groep wordt overboord gegooid. "
  answers:
  - skillNeeded:
    - skillType: 0
      skillAmountNeeded: 10
    action: '(Aanpassingsvermogen > 10) Spring in het water om het kind te redden '
    result: 'Je redt het kind. Je verliest 2 Honger, verdient 5 Sociaal. '
    change:
    - skillToBeChanged: 3
      changeAmount: 5
    - skillToBeChanged: 6
      changeAmount: -2
  - skillNeeded: []
    action: 'Probeer het kind met een touw of plank te bereiken '
    result: 'Je bereikt het kind bijna, maar het kost veel moeite. Je verdient 5
      Aanpassingsvermogen, verliest 1 Honger. '
    change:
    - skillToBeChanged: 0
      changeAmount: 5
    - skillToBeChanged: 6
      changeAmount: -1
  - skillNeeded: []
    action: 'Niets doen en wacht af '
    result: 'Het kind gaat overboord en verdrinkt. Je veliest 5 sociaal en 2 aanpassingsvermogen '
    change:
    - skillToBeChanged: 3
      changeAmount: -5
    - skillToBeChanged: 0
      changeAmount: -2
