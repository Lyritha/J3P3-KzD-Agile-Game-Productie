  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 4
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: "Een hevige storm slaat toe tijdens de overtocht. E\xE9n kind van een
    andere groep wordt overboord gegooid. "
  answers:
  - skillNeeded:
    - skillType: 0
      skillAmountNeeded: 2
    action: Probeer het water in te springen om he tkind uit het water te halen.
    result: 'Je springt het water in en pakt het kind. Een paar andere reizigers
      op de boot helpen je terug de boot op. Je hebt het kind succesvol gered.


      Verdien
      2 sociaal.'
    resultFailed: 'Je springt het water in en probeert het kind het water uit te
      halen. Helaas komt er een grote golf aan die je meeneemt onderwater. Je overleeft
      het niet.


      Je karakter gaat dood.'
    change:
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 7
      changeAmount: 0
  - skillNeeded:
    - skillType: 0
      skillAmountNeeded: 2
    action: 'Probeer het kind met een touw of plank te bereiken '
    result: 'Je gooit een touw naar beneden om het kind te proberen te helpen. Het
      lukt het kind om het touw te pakken, en een paar andere reizigers helpen je
      met het kind weer op de boot te trekken.


      Verdien 2 sociaal.'
    resultFailed: 'Je gooit een touw naar beneden om te proberen het kind terug te
      trekken. Helaas mis je het touw en raak je het kind op hun hoofd, dit drukt
      ze onderwater en komen ze niet meer boven water.


      Verlies 2 sociaal.'
    change:
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -2
  - skillNeeded: []
    action: Je doet niks en wacht het af.
    result: 'Je ziet een paar andere reizigers hun best doen om het kind terug het
      schip op te halen. Een van die reizigers vallen ook in het water. Geen van
      hun overleeft.


      Verlies 2 sociaal. Verlies 2 aanpassingsvermogen.'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: -2
    - skillToBeChanged: 0
      changeAmount: -2
