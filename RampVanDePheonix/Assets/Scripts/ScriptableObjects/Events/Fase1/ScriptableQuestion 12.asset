%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 12
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: Je bent onderweg naar de boot, maar uiteindelijk is je eten op geraakt!
    Er is een dorp onderweg naar de boot maar de prijzen daar zijn heel hoog.
  answers:
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: Koop eten bij het volgende dorp voor de hoge prijs.
    result: 'Je besluit om bij het volgende dorp eten te kopen. Je bent niet blij
      met de hoge prijzen, maar het zou maar moeten om de reis te overleven.


      Verlies
      2 kapitaal, verdien 2 voedselvoorraad'
    resultFailed: Je hebt niet genoeg geld om het eten te kopen.  Je hoopt dat het
      volgende dorp een betere prijs heeft voor het eten.
    change:
    - skillToBeChanged: 1
      changeAmount: -3
    - skillToBeChanged: 6
      changeAmount: 2
    changeFailed: []
  - skillNeeded:
    - skillType: 0
      skillAmountNeeded: 3
    action: Probeer een dier te jagen onderweg.
    result: 'Je vind een dier onderweg en hebt hem succesvol gejaagd. Je neemt hem
      mee in je etensvoorraad.


      Verdien 2 etensvoorraad, verdien 2 aanpassingsvermogen.'
    resultFailed: 'het lukt je niet om het dier te jagen. Het dier steelt wat eten
      van je en rent snel weg.


      Verlies 1 etensvoorraad, verlies 1 aanpassingsvermogen.'
    change:
    - skillToBeChanged: 0
      changeAmount: 2
    - skillToBeChanged: 5
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 0
      changeAmount: -1
    - skillToBeChanged: 6
      changeAmount: -1
