%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 8
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'De Dominee komt langs de deur om te vragen voor een vrije gift voor
    de kerk, omdat de kerk nooit genoeg geld heeft. '
  answers:
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 2
    action: Natuurlijk! Ik zou graag willen helpen
    result: 'De dominee bedankt je voor je gift en verantwoord je dat jouw gift goed
      gebruikt gaat worden en totaal niet in zijn eigen zak gedrukt word.


      Verlies
      1 kapitaal.'
    resultFailed: Je hebt niet genoeg kapitaal om te geven. De dominee kijkt je raar
      aan en loopt langzaam weg.
    change:
    - skillToBeChanged: 1
      changeAmount: -2
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed: []
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: 'Voor een extra gift krijg je ook nog een bijbel erbij! '
    result: 'De dominee bedankt je en verteld je dat je bijbel binnen 3 tot 5 werkdagen
      bezorgd word. Helaas ben je dan al op reis en ben je dus niet thuis om hem
      te ontvangen.


      Verlies 2 kapitaal, Verdien 2 sociaal.'
    resultFailed: 'Je hebt niet genoeg kapitaal om te geven. De dominee kijkt je
      raar aan en loopt langzaam weg. Hij pakt ook 1 bijbel van je af.


      Verlies
      1 leervermogen'
    change:
    - skillToBeChanged: 1
      changeAmount: -3
    - skillToBeChanged: 3
      changeAmount: 2
    changeFailed:
    - skillToBeChanged: 4
      changeAmount: -1
  - skillNeeded: []
    action: Je hebt op dit moment niet het budget om een gift te geven
    result: 'De dominee kijkt je raar aan en begint langzaam weg te lopen. De andere
      dorpsgenoten beginnen je nu ook raar aan te kijken wanneer je langs loopt.


      Verlies
      1 sociaal'
    resultFailed: 
    change:
    - skillToBeChanged: 3
      changeAmount: -1
    changeFailed: []
