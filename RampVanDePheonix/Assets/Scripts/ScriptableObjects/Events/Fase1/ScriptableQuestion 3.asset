MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'De oogst dit jaar ging niet zoals gehoopt, en je zit nu zonder genoeg
    eten om tot de volgende oogst te overleven, wat zou je nu doen? '
  answers:
  - skillNeeded:
    - skillType: 3
      skillAmountNeeded: 1
    action: Bedelen bij vrienden, familie en in het dorp
    result: 'Je familie vind het goed om je wat geld te geven voor eten.


      Verdien
      1 kapitaal'
    resultFailed: Je familie vind dat je zelf de reis moet betalen en geeft je geen
      kapitaal.
    change:
    - skillToBeChanged: 1
      changeAmount: 1
    changeFailed: []
  - skillNeeded:
    - skillType: 0
      skillAmountNeeded: 2
    - skillType: 2
      skillAmountNeeded: 1
    action: Inbreken bij je buurman en eten stelen
    result: "Het is je gelukt om in te breken! Je pakt zijn geld en rent de deur
      uit!. \n\nVerden 3 kapitaal."
    resultFailed: Je probeerde in te breken, maar de buurman was thuis. Hij gooit
      je het huis uit en scheld je uit voor het hele dorp.
    change:
    - skillToBeChanged: 1
      changeAmount: 3
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -2
