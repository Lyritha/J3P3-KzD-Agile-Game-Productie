%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 4
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: Er is opeens een wiel van de kar afgevallen! De reis word een stuk moeilijker
    als je dit niet kan oplossen.
  answers:
  - skillNeeded:
    - skillType: 2
      skillAmountNeeded: 1
    action: Je doet je best om de kar zelf te repareren.
    result: 'Je hebt je innerlijke timmerman naar buiten gehaald en de kar gerepareerd.

      Verdien
      1 bouwkunde.'
    resultFailed: Het is je niet gelukt om de kar te repareren. Gelukkig vond een
      dorpsgenoot je en heeft hij je geholpen.
    change:
    - skillToBeChanged: 2
      changeAmount: 1
    changeFailed:
    - skillToBeChanged: 0
      changeAmount: -1
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 1
    action: Je besluit om iemand uit het dorp in te huren om de kar te repareren.
    result: 'De timmerman heeft succesvol de kar gerepareerd. Je geeft de man zijn
      geld en als bedankje maak je nog even zijn klompen voor hem schoon.


      Verlies
      1 kapitaal, verdien 1 sociaal'
    resultFailed: 'De timmerman heeft succesvol de kar gerepareerd, maar je had niet
      genoeg kapitaal om hem te betalen. Je gaat snel verder met de kar voordat hij
      erachter komt.


      Verlies 1 sociaal'
    change:
    - skillToBeChanged: 1
      changeAmount: -1
    - skillToBeChanged: 3
      changeAmount: 1
    changeFailed:
    - skillToBeChanged: 3
      changeAmount: -1
