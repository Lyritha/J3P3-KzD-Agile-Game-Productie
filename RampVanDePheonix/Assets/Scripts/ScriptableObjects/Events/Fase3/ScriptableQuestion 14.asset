%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 14
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'In Amerika hebben ze veel strengere winters dan je gewend bent in de
    achterhoek. Je was hier niet op voorbereid en de oogst is verpest. '
  answers:
  - skillNeeded:
    - skillType: 1
      skillAmountNeeded: 3
    action: Je besluit om extra kapitaal uit te geven om meer eten te kopen
    result: Je hebt genoeg kapitaal om het eten te halen bij de markt, je hebt je
      voorraad mooi opgevuld.
    resultFailed: Je hebt niet genoeg kapitaal om extra eten te halen, wat van je
      opgeslagen voedsel van vorige oogst is ook bedorven gegaan.
    change:
    - skillToBeChanged: 1
      changeAmount: -3
    - skillToBeChanged: 5
      changeAmount: 5
    changeFailed:
    - skillToBeChanged: 5
      changeAmount: -2
  - skillNeeded:
    - skillType: 5
      skillAmountNeeded: 6
    action: Je waagt het erop dat je genoeg voorraad hebt om de winter te overleven
      en probeert het te doen met de voorraad die je nu hebt.
    result: Je had genoeg voorraad om de winter te overleven, iedereen heeft meer
      dan genoeg kunnen eten.
    resultFailed: Je had niet genoeg eten op voorraad, Je hebt je best gedaan om
      het overige eten netjes te verdelen, maar iedereen is wel zeer hongerig geworden.
    change:
    - skillToBeChanged: 5
      changeAmount: -6
    changeFailed:
    - skillToBeChanged: 5
      changeAmount: -5
    - skillToBeChanged: 6
      changeAmount: 2
