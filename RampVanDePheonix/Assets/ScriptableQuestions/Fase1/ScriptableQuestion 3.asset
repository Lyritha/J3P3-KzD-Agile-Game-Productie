  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'De oogst dit jaar ging niet zoals gehoopt, en je zit nu zonder genoeg
    eten om tot de volgende oogst te overleven, wat zou je nu doen? '
  answers:
  - action: Bedelen bij vrienden, familie en in het dorp
    result: 'verlies 2 Socialiteit, krijg 1 Aanpassingsvermogen en verdient 1 Honger
      per karakter. '
    change:
    - skillToBeChanged: 0
      changeAmount: -5
  - action: Zelf eten kopen van je opgespaarde geld
    result: 'verlies 2 Kapitaal en verdien 3 Honger per karakter. '
    change: []
  - action: Inbreken bij je buurman en eten stelen
    result: 'verlies 2 Socialiteit, krijg 1 Bouwkunde, 1 Aanpassingsvermogen en verdien
      2 Honger per karakter. '
    change: []
  - action: Er doorheen duwen en de laatste beetjes eten verdelen
    result: 'verlies 1 Honger per karakter, verdien 2 Aanpassingsvermogen en 1 Kapitaal. '
    change: []
