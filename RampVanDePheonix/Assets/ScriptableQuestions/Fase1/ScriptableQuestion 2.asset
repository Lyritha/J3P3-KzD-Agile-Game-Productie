MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion 2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'Je vrienden nodigen je uit om een klein afscheidsfeest te vieren bij
    de lokale kroeg voordat je vertrekt, ga je er heen? '
  answers:
  - action: Ja klinkt wel gezellig, ook al zijn de drankjes wel wat prijzig
    result: 'verlies 2 Kapitaal en krijg 2 Socialiteit. '
    change:
    - skillToBeChanged: 1
      changeAmount: 2
    - skillToBeChanged: 3
      changeAmount: 2
  - action: Ik denk dat ik mijn geld ga opsparen en een rustig avondje thuisblijf
    result: 'verlies 1 Socialiteit en krijg 1 Kapitaal. '
    change:
    - skillToBeChanged: 3
      changeAmount: 1
    - skillToBeChanged: 1
      changeAmount: 1
  - action: In plaats van bij de kroeg nodig je ze thuis uit, is even gezellig en
      ook goedkoper
    result: 'krijg 1 Socialiteit en 1 Aanpassingsvermogen '
    change:
    - skillToBeChanged: 3
      changeAmount: 1
    - skillToBeChanged: 0
      changeAmount: 1
