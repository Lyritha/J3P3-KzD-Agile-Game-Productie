  m_Script: {fileID: 11500000, guid: f3f24b34962421844ad543408636ad0f, type: 3}
  m_Name: ScriptableQuestion
  m_EditorClassIdentifier: Assembly-CSharp::QuestionScriptable
  question: 'Je bent van plan om wat spullen te verkopen om de reis naar Amerika
    te financieren, wat verkoop je? '
  answers:
  - action: Je gereedschapskist
    result: 'verlies 1 Bouwkunde en krijg 1 Kapitaal. '
    change:
    - skillToBeChanged: 2
      changeAmount: -1
    - skillToBeChanged: 1
      changeAmount: 1
  - action: Je Engelstalige boeken
    result: 'verlies 1 Leervermogen en krijg 1 Kapitaal. '
    change:
    - skillToBeChanged: 4
      changeAmount: -1
    - skillToBeChanged: 1
      changeAmount: 1
  - action: 'Bij nader inzien hoef ik niet echt iets te verkopen. '
    result: er word niks verkocht
    change:
    - skillToBeChanged: 1
      changeAmount: 0
